APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DRIVER=local
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=us-east-1
BACKUP_AWS_BUCKET=
BACKUP_AWS_PATH=backups

BACKUP_GOOGLE_CLIENT_ID=
BACKUP_GOOGLE_CLIENT_SECRET=
BACKUP_GOOGLE_REFRESH_TOKEN=
BACKUP_GOOGLE_FOLDER_ID=

BACKUP_DROPBOX_ACCESS_TOKEN=
BACKUP_DROPBOX_PATH=/backups

BACKUP_COMPRESSION_ENABLED=false
BACKUP_COMPRESSION_TYPE=gzip
BACKUP_COMPRESSION_LEVEL=6

BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_DRIVER=openssl
BACKUP_ENCRYPTION_CIPHER=AES-256-CBC
BACKUP_ENCRYPTION_KEY=

BACKUP_NOTIFICATIONS_ENABLED=false
BACKUP_NOTIFY_EMAIL=false
BACKUP_NOTIFY_SLACK=false
BACKUP_NOTIFY_DISCORD=false
BACKUP_NOTIFY_TELEGRAM=false
BACKUP_NOTIFY_RECIPIENTS=

BACKUP_WEBHOOK_SLACK=
BACKUP_WEBHOOK_DISCORD=
BACKUP_WEBHOOK_TELEGRAM_BOT_TOKEN=
BACKUP_WEBHOOK_TELEGRAM_CHAT_ID=

BACKUP_SCHEDULE_ENABLED=true
BACKUP_SCHEDULE_DEFAULT_CRON="0 0 * * *"
BACKUP_SCHEDULE_TIMEZONE=UTC

BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_AUTO_CLEANUP=true

BACKUP_AUTO_VERIFY=true
BACKUP_CHECKSUM_ALGORITHM=sha256

BACKUP_DUPLICATE_DETECTION=true
BACKUP_DUPLICATE_STRATEGY=skip

BACKUP_STORAGE_ALERTS_ENABLED=true
BACKUP_STORAGE_WARNING_THRESHOLD_MB=1024
BACKUP_STORAGE_CRITICAL_THRESHOLD_MB=5120

VITE_APP_NAME="${APP_NAME}"
